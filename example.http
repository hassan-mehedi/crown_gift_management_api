### Variables
@baseUrl = http://localhost:5000/api
# MANUAL: Replace this with the actual token after login
@authToken = your_jwt_auth_token_here

### ---------------------- USERS ---------------------- ###

### User Registration
# @name register
POST {{baseUrl}}/users/register
Content-Type: application/json

{
    "name": "Test User",
    "email": "test@example.com",
    "department": "IT",
    "phone": "1234567890",
    "password": "password123",
    "designation": "Developer"
}

### User Login
# After successful login, copy the token from the response and update the @authToken variable above
# @name login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
    "phone": "1234567890",
    "password": "password123"
}

### Store Auth Token
@authToken = {{login.response.body.data.token}}

### Get All Users
GET {{baseUrl}}/users

### Get All Users with Pagination
GET {{baseUrl}}/users?page=1&limit=10

### Get User by Phone
GET {{baseUrl}}/users/1234567890

### Update User
PATCH {{baseUrl}}/users/1234567890
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Updated User",
    "department": "Engineering"
}

### Delete User
DELETE {{baseUrl}}/users/1234567890
Authorization: Bearer {{authToken}}

### ---------------------- STOCK ITEMS ---------------------- ###

### Get All Stock Items
GET {{baseUrl}}/stock-items

### Get All Stock Items with Pagination
GET {{baseUrl}}/stock-items?page=1&limit=10

### Get Stock Item by ID
GET {{baseUrl}}/stock-items/{{stockItemId}}

### Create Stock Item
# @name createStockItem
POST {{baseUrl}}/stock-items
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Laptop",
    "quantity": 10,
    "storage": "Warehouse A",
    "totalCost": 12000,
    "picture": "laptop.jpg",
    "date": "2023-06-15"
}

### Store Stock Item ID
@stockItemId = {{createStockItem.response.body.data.stockItem._id}}

### Create Multiple Stock Items
POST {{baseUrl}}/stock-items
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
    {
        "name": "Mouse",
        "quantity": 20,
        "storage": "Warehouse B",
        "totalCost": 1000,
        "date": "2023-06-15"
    },
    {
        "name": "Keyboard",
        "quantity": 15,
        "storage": "Warehouse B",
        "totalCost": 1500,
        "date": "2023-06-15"
    }
]

### Update Stock Item
PATCH {{baseUrl}}/stock-items/{{stockItemId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "quantity": 15,
    "totalCost": 15000
}

### Delete Stock Item
DELETE {{baseUrl}}/stock-items/{{stockItemId}}
Authorization: Bearer {{authToken}}

### ---------------------- STOCK MODIFICATIONS ---------------------- ###

### Get All Stock Modifications
GET {{baseUrl}}/stock-modifications

### Get All Stock Modifications with Pagination
GET {{baseUrl}}/stock-modifications?page=1&limit=10

### Get Stock Modification by ID
GET {{baseUrl}}/stock-modifications/{{stockModificationId}}

### Create Stock Modification
# @name createStockModification
POST {{baseUrl}}/stock-modifications
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "stockItemId": "{{stockItemId}}",
    "quantity": 50,
    "date": "2023-06-20T10:30:00.000Z"
}

### Store Stock Modification ID
@stockModificationId = {{createStockModification.response.body.data.stockModification._id}}

### Create Multiple Stock Modifications
POST {{baseUrl}}/stock-modifications
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
    {
        "stockItemId": "{{stockItemId}}",
        "quantity": 25,
        "date": "2023-06-20T10:30:00.000Z"
    },
    {
        "stockItemId": "{{stockItemId}}",
        "quantity": 30,
        "date": "2023-06-21T11:30:00.000Z"
    }
]

### Update Stock Modification
PATCH {{baseUrl}}/stock-modifications/{{stockModificationId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "quantity": 75,
    "date": "2023-06-22T12:00:00.000Z"
}

### Delete Stock Modification
DELETE {{baseUrl}}/stock-modifications/{{stockModificationId}}
Authorization: Bearer {{authToken}}

### Get Stock Modifications by Stock Item ID
GET {{baseUrl}}/stock-modifications/stock-item/{{stockItemId}}

### Get Stock Modifications by Stock Item ID with Pagination
GET {{baseUrl}}/stock-modifications/stock-item/{{stockItemId}}?page=1&limit=5

### Get Stock Modification Count for Stock Item
GET {{baseUrl}}/stock-modifications/stock-item/{{stockItemId}}/count

### ---------------------- RECEIVERS ---------------------- ###

### Get All Receivers
GET {{baseUrl}}/receivers

### Get All Receivers with Pagination
GET {{baseUrl}}/receivers?page=1&limit=10

### Get Receiver by ID
GET {{baseUrl}}/receivers/{{receiverId}}

### Get Receiver by Phone
GET {{baseUrl}}/receivers/phone/9876543210

### Create Receiver
# @name createReceiver
POST {{baseUrl}}/receivers
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "John Doe",
    "phone": "9876543210",
    "email": "john@example.com",
    "department": "Marketing"
}

### Store Receiver ID
@receiverId = {{createReceiver.response.body.data.receiver._id}}

### Create Multiple Receivers
POST {{baseUrl}}/receivers
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
    {
        "name": "Jane Doe",
        "phone": "9876543211",
        "email": "jane@example.com",
        "department": "HR"
    },
    {
        "name": "Bob Smith",
        "phone": "9876543212",
        "email": "bob@example.com",
        "department": "Finance"
    }
]

### Update Receiver
PATCH {{baseUrl}}/receivers/{{receiverId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "John Smith",
    "department": "Sales"
}

### Delete Receiver
DELETE {{baseUrl}}/receivers/{{receiverId}}
Authorization: Bearer {{authToken}}

### ---------------------- STOCK ISSUES ---------------------- ###

### Get All Stock Issues
GET {{baseUrl}}/stockIssues

### Get All Stock Issues with Pagination
GET {{baseUrl}}/stockIssues?page=1&limit=10

### Get Stock Issue by ID
GET {{baseUrl}}/stockIssues/{{stockIssueId}}

### Get Stock Issues by Receiver ID
GET {{baseUrl}}/stockIssues/receiver/{{receiverId}}

### Get Stock Issues by Receiver ID with Pagination
GET {{baseUrl}}/stockIssues/receiver/{{receiverId}}?page=1&limit=10

### Get Stock Issues by Stock Item ID
GET {{baseUrl}}/stockIssues/stockItem/{{stockItemId}}

### Get Stock Issues by Stock Item ID with Pagination
GET {{baseUrl}}/stockIssues/stockItem/{{stockItemId}}?page=1&limit=10

### Create Stock Issue
# @name createStockIssue
POST {{baseUrl}}/stockIssues
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "stockItemId": "{{stockItemId}}",
    "quantity": 2,
    "receiverId": "{{receiverId}}",
    "date": "2023-06-20"
}

### Store Stock Issue ID
@stockIssueId = {{createStockIssue.response.body.data.stockIssue._id}}

### Update Stock Issue
PATCH {{baseUrl}}/stockIssues/{{stockIssueId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "quantity": 3,
    "date": "2023-06-21"
}

### Delete Stock Issue
DELETE {{baseUrl}}/stockIssues/{{stockIssueId}}
Authorization: Bearer {{authToken}}

### ---------------------- VENDORS ---------------------- ###

### Get All Vendors
GET {{baseUrl}}/vendors

### Get All Vendors with Pagination
GET {{baseUrl}}/vendors?page=1&limit=10

### Get Vendor by Phone
GET {{baseUrl}}/vendors/phone/1234567890

### Get Vendor by ID
GET {{baseUrl}}/vendors/id/{{vendorId}}

### Create Vendor
# @name createVendor
POST {{baseUrl}}/vendors
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "ABC Suppliers",
    "phone": "1234567890",
    "email": "contact@abcsuppliers.com",
    "address": "123 Business Street, City",
    "contactPerson": "John Manager"
}

### Store Vendor ID
@vendorId = {{createVendor.response.body.data.vendor._id}}

### Update Vendor by Phone
PATCH {{baseUrl}}/vendors/phone/1234567890
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "ABC Premium Suppliers",
    "contactPerson": "Jane Manager",
    "address": "456 Business Avenue, City"
}

### Update Vendor by ID
PATCH {{baseUrl}}/vendors/id/{{vendorId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "email": "info@abcsuppliers.com",
    "phone": "1234567891"
}

### Delete Vendor by Phone
DELETE {{baseUrl}}/vendors/phone/1234567890
Authorization: Bearer {{authToken}}

### Delete Vendor by ID
DELETE {{baseUrl}}/vendors/id/{{vendorId}}
Authorization: Bearer {{authToken}}
