### Variables
@baseUrl = http://localhost:5000/api
# MANUAL: Replace this with the actual token after login
@authToken = your_jwt_auth_token_here

### User Registration
# @name register
POST {{baseUrl}}/users/register
Content-Type: application/json

{
    "name": "Test User",
    "email": "test@example.com",
    "department": "IT",
    "phone": "1234567890",
    "password": "password123",
    "designation": "Developer"
}

### User Login
# After successful login, copy the token from the response and update the @authToken variable above
POST {{baseUrl}}/users/login
Content-Type: application/json

{
    "phone": "1234567890",
    "password": "password123"
}

### Get Current User
GET {{baseUrl}}/users/me
Authorization: Bearer {{authToken}}

### Get All Users
GET {{baseUrl}}/users

### Get User by Phone
GET {{baseUrl}}/users/1234567890

### Update User
PATCH {{baseUrl}}/users/1234567890
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Updated User",
    "department": "Engineering"
}

### Delete User
DELETE {{baseUrl}}/users/1234567890
Authorization: Bearer {{authToken}}

### ---------------------- STOCK ITEMS ---------------------- ###

### Get All Stock Items
GET {{baseUrl}}/stock-items

### Get Stock Item by ID
GET {{baseUrl}}/stock-items/{{stockItemId}}

### Create Stock Item
# @name createStockItem
POST {{baseUrl}}/stock-items
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Laptop",
    "quantity": 10,
    "storage": "Warehouse A",
    "totalCost": 12000,
    "picture": "laptop.jpg",
    "date": "2023-06-15"
}

### Store Stock Item ID
@stockItemId = {{createStockItem.response.body.data.stockItem._id}}

### Update Stock Item
PATCH {{baseUrl}}/stock-items/{{stockItemId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "quantity": 15,
    "totalCost": 15000
}

### Delete Stock Item
DELETE {{baseUrl}}/stock-items/{{stockItemId}}
Authorization: Bearer {{authToken}}

### Create Multiple Stock Items
POST {{baseUrl}}/stock-items
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
    {
        "name": "Mouse",
        "quantity": 20,
        "storage": "Warehouse B",
        "totalCost": 1000,
        "date": "2023-06-15"
    },
    {
        "name": "Keyboard",
        "quantity": 15,
        "storage": "Warehouse B",
        "totalCost": 1500,
        "date": "2023-06-15"
    }
]

### ---------------------- RECEIVERS ---------------------- ###

### Get All Receivers
GET {{baseUrl}}/receivers

### Get Receiver by ID
GET {{baseUrl}}/receivers/{{receiverId}}

### Get Receiver by Phone
GET {{baseUrl}}/receivers/phone/9876543210

### Create Receiver
# @name createReceiver
POST {{baseUrl}}/receivers
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "John Doe",
    "phone": "9876543210",
    "email": "john@example.com",
    "department": "Marketing"
}

### Store Receiver ID
@receiverId = {{createReceiver.response.body.data.receiver._id}}

### Update Receiver
PATCH {{baseUrl}}/receivers/{{receiverId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "John Smith",
    "department": "Sales"
}

### Delete Receiver
DELETE {{baseUrl}}/receivers/{{receiverId}}
Authorization: Bearer {{authToken}}

### Create Multiple Receivers
POST {{baseUrl}}/receivers
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
    {
        "name": "Jane Doe",
        "phone": "9876543211",
        "email": "jane@example.com",
        "department": "HR"
    },
    {
        "name": "Bob Smith",
        "phone": "9876543212",
        "email": "bob@example.com",
        "department": "Finance"
    }
]

### ---------------------- GIFTS ---------------------- ###

### Get All Gifts
GET {{baseUrl}}/gifts

### Get Gift by ID
GET {{baseUrl}}/gifts/{{giftId}}

### Get Gifts by Receiver ID
GET {{baseUrl}}/gifts/receiver/{{receiverId}}

### Get Gifts by Stock Item ID
GET {{baseUrl}}/gifts/stockItem/{{stockItemId}}

### Create Gift
# @name createGift
POST {{baseUrl}}/gifts
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "stockItemId": "{{stockItemId}}",
    "quantity": 2,
    "receiverId": "{{receiverId}}",
    "date": "2023-06-20"
}

### Store Gift ID
@giftId = {{createGift.response.body.data.gift._id}}

### Update Gift
PATCH {{baseUrl}}/gifts/{{giftId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "quantity": 3,
    "date": "2023-06-21"
}

### Delete Gift
DELETE {{baseUrl}}/gifts/{{giftId}}
Authorization: Bearer {{authToken}}
